+            grp = _finger_groups.get(t) if transistor is not None else None
+            if grp is not None and len(grp) > 1:
+                for k, ft in enumerate(grp):
+                    src = l if (k % 2 == 0) else r
+                    ts.append(ft if ft.source_net == src else ft.flipped())
