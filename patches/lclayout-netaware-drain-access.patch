diff --git a/src/lclayout/router.py b/src/lclayout/router.py
index 1c3349f..980d4bd 100644
--- a/src/lclayout/router.py
+++ b/src/lclayout/router.py
@@ -6,6 +6,7 @@ from .graphrouter.graphrouter import GraphRouter, GraphRoutingProblem
 from .routing_graph import *
 from . import tech_util
 from .lvs import lvs
+from lccommon.net_util import is_power_net
 import networkx as nx
 import numpy
 import klayout.db as db
@@ -424,6 +425,95 @@ class DefaultRouter():
         # Embed transistor terminal nodes in to routing graph.
         terminals_by_net.extend(embed_transistor_terminal_nodes(graph, transistor_layouts, tech))
 
+        # --- Option A: net-aware diffusion terminal access (sky130-port fix) ---
+        # A diffusion source/drain terminal exposes routing nodes at BOTH the
+        # rail-adjacent edge and the far edge of the active area (see the active-
+        # border access points added to xs/ys above). The routing graph is
+        # net-agnostic, so for a DRAIN/signal net the router may contact at the
+        # rail-adjacent edge; the resulting li1 pad then abuts the power rail
+        # (same layer, shared edge) and the two nets merge -> short. This is the
+        # nor3/nor4/or3/xnor2/o21ai/o22ai/a211oi... class (parallel pulldown/pullup
+        # puts several signal drains flush against the rail). A SOURCE terminal
+        # legitimately shares the rail net and MUST stay flush against the rail.
+        # Fix: for a diffusion terminal whose net is NOT a power net, drop the
+        # nodes whose li1 contact pad would touch/violate spacing to the near
+        # power rail, keeping the far-side node(s) -- exactly what the inverter
+        # does naturally. Applied AFTER the LVS terminal-join + transistor-terminal
+        # embedding so it operates on the final terminal set the router actually
+        # uses. Never empty a terminal: only drop when a clearing node remains.
+        def _rail_clearance(contact_layer):
+            import os as _os
+            reach = tech.via_size[contact_layer] // 2 \
+                + tech.minimum_enclosure.get((l_metal1, contact_layer), 0)
+            spacing = tech.min_spacing.get((l_metal1, l_metal1),
+                                           tech.wire_width.get(l_metal1, 0))
+            # RECIPE_LIFT_TIGHT=1: require only that the lifted pad does NOT TOUCH
+            # the rail (reach), not full li1 spacing. Narrow transistors (small W)
+            # have a diffusion so short that no node clears the full-spacing zone
+            # (clearcols=0 -> lift can't fire -> drain shorts to rail). Reach-only
+            # gets a clearing node; the pad may sit within li1 spacing of the rail
+            # (a DRC nit, DRC-dirty) but is LVS-clean (no merge).
+            if int(_os.environ.get("RECIPE_LIFT_TIGHT", "0")):
+                return reach
+            return reach + spacing
+        _rail_top_edge = tech.power_rail_width // 2                          # bottom (VSS) rail
+        _rail_bot_edge = tech.unit_cell_height - tech.power_rail_width // 2  # top (VDD) rail
+        # (diffusion layer -> (contact layer, which rail is adjacent))
+        _diff_rail = {
+            l_ndiffusion: (l_ndiff_contact, 'bottom'),
+            l_pdiffusion: (l_pdiff_contact, 'top'),
+        }
+        # Pass 1: aggregate, per (net, diffusion layer), the rail-adjacent ("would
+        # short") nodes and the clearing columns -- across ALL terminal entries of
+        # that net. extract_terminal_nodes emits one entry per diffusion shape, so a
+        # NOR's two parallel drains arrive as two SEPARATE single-column entries;
+        # they must be summed to see the >=2-column signature.
+        _railadj = {}    # (net, dlayer) -> set of rail-adjacent nodes
+        _clearcols = {}  # (net, dlayer) -> set of clearing columns
+        for _net, _terms in terminals_by_net:
+            if _net is None or is_power_net(_net):
+                continue
+            for _dlayer, (_clayer, _side) in _diff_rail.items():
+                _nodes = [t for t in _terms if t[0] == _dlayer]
+                if not _nodes:
+                    continue
+                _clr = _rail_clearance(_clayer)
+                if _side == 'bottom':
+                    _clears = [t for t in _nodes if (t[1][1] - _clr) > _rail_top_edge]
+                else:
+                    _clears = [t for t in _nodes if (t[1][1] + _clr) < _rail_bot_edge]
+                _railadj.setdefault((_net, _dlayer), set()).update(set(_nodes) - set(_clears))
+                _clearcols.setdefault((_net, _dlayer), set()).update(t[1][0] for t in _clears)
+        # Decide what to lift: a (net, dlayer) is the NOR/AOI short signature iff its
+        # rail-adjacent contacts span >=2 distinct COLUMNS (parallel drains forcing a
+        # low horizontal li1 run that merges with the rail) AND a clearing node exists
+        # to relocate to. Single-column rail-adjacent contacts (series/inverter drains)
+        # are left alone: the router routes them up on its own, and lifting them only
+        # adds middle-band congestion that can make compound cells unroutable.
+        _drop_nodes = set()
+        if getattr(tech, 'lift_signal_drains', False):
+            import os as _os
+            # Column threshold: default 2 = only the parallel-drain signature (avoids
+            # over-constraining single-height 2-layer cells). With more routing room
+            # (extra metal layers or double-height cells) single-column internal
+            # nodes can be lifted too -> set RECIPE_LIFT_MIN_COLS=1.
+            _lift_min_cols = int(_os.environ.get("RECIPE_LIFT_MIN_COLS", "2"))
+            for _key, _adj in _railadj.items():
+                _cols = {t[1][0] for t in _adj}
+                if len(_cols) >= _lift_min_cols and _clearcols.get(_key):
+                    logger.info(
+                        f"net-aware access: net='{_key[0]}' layer={_key[1]} lifting "
+                        f"{len(_adj)} rail-adjacent contact(s) across {len(_cols)} columns "
+                        f"off the rail.")
+                    _drop_nodes.update(_adj)
+        # Pass 2: remove the marked rail-adjacent nodes from every terminal entry.
+        if _drop_nodes:
+            terminals_by_net = [
+                (_net, [t for t in _terms if t not in _drop_nodes])
+                for _net, _terms in terminals_by_net
+            ]
+        # --- end Option A ---
+
         # Check if each net really has a routing terminal.
         # It can happen that there is none due to spacing issues.
         error = False
