+import os
+# --- Placement search caps (env-tunable) -----------------------------------
+# HierarchicalPlacer.place() enumerates sub-cell permutations (P! x N!) plus an
+# intra-sub-cell product; this is O(n!) in the sub-cell count and HANGS on
+# high-drive cells (drive-2/4/8 have many parallel devices -> many sub-cells),
+# which is the dominant FAIL:timeout cause across the library. These caps bound
+# the search. permutations() yields the identity (natural netlist) order FIRST,
+# so the un-permuted placement -- usually a sane one -- is always evaluated;
+# capping only drops far-out permutations. Result stays LVS-correct; only
+# placement/wiring quality can degrade. Generous defaults; lower per-cell via env
+# for pathological cells, and the caps are inert on small cells (n! < cap).
+_PLACE_PERM_CAP  = int(os.environ.get("RECIPE_PLACE_PERM_CAP",  "5040"))   # per-row perms (<=7!)
+_PLACE_COMBO_CAP = int(os.environ.get("RECIPE_PLACE_COMBO_CAP", "20000"))  # outer P! x N! product
+_PLACE_INNER_CAP = int(os.environ.get("RECIPE_PLACE_INNER_CAP", "5000"))   # intra-sub-cell product
+# Cap on Euler tours enumerated per diffusion graph. find_all_euler_tours is
+# exponential; unbounded it hangs on high-drive cells (drive-4 = ~32 devices).
+# meta_placer already caps at 200; _find_optimal_single_row_placements did NOT.
+_PLACE_EULER_TOUR_CAP = int(os.environ.get("RECIPE_PLACE_EULER_TOUR_CAP", "200"))
+# RECIPE_GROUP_FINGERS (0/1): collapse identical parallel transistors (the fingers
+# that run_cell.sh EXPAND makes from m=N) into ONE representative edge before the
+# Euler-tour search, then expand them back as adjacent fingers. Without this, K
+# identical fingers create K! equivalent Euler tours that blow the tour budget on
+# junk permutations, so the (already gate-alignment-aware) search never reaches a
+# routable ordering -> high-drive/complex cells don't route. Default 0 (unchanged).
+_GROUP_FINGERS = bool(int(os.environ.get("RECIPE_GROUP_FINGERS", "0")))
+
+
+def _collapse_fingers(graph):
+    """Collapse identical parallel transistors (fingers) into a single representative
+    edge. Returns (collapsed_multigraph, {representative_transistor: [all fingers]}).
+    Two transistors are interchangeable fingers iff they connect the same node pair
+    and have the same gate net, width and length."""
+    import networkx as _nx
+    collapsed = _nx.MultiGraph()
+    groups = {}
+    seen = {}  # (frozenset{u,v}, gate, w, l) -> representative transistor
+    for u, v, t in graph.edges(keys=True):
+        key = None
+        if isinstance(t, Transistor):
+            key = (frozenset((u, v)), t.gate_net, t.channel_width, t.channel_length)
+        if key is not None and key in seen:
+            groups[seen[key]].append(t)
+        else:
+            collapsed.add_edge(u, v, t)
+            if key is not None:
+                seen[key] = t
+                groups[t] = [t]
+    return collapsed, groups
+
 import logging
 
 logger = logging.getLogger(__name__)
