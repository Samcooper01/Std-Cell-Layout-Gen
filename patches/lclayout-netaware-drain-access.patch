diff --git a/src/lclayout/place/euler_placer.py b/src/lclayout/place/euler_placer.py
index c05d4bd..f3fb072 100644
--- a/src/lclayout/place/euler_placer.py
+++ b/src/lclayout/place/euler_placer.py
@@ -18,6 +18,55 @@ import networkx as nx
 from . import eulertours
